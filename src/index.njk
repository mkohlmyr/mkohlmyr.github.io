---
layout: main
pagination:
  data: collections.articles
  size: 6
  alias: articles
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<section class="hero">
  <h1 class="hero-tagline">Building great products and high-performing software engineering teams.</h1>
</section>

<div class="article-grid">
  {% for article in articles %}
    <article class="article-card">
      <a href="{{ article.url }}" class="article-card-link">
        <div class="article-card-image-container">
          <img src="/assets/images/cover/{{ article.data.cover }}" alt="{{ article.data.title }}"/>
        </div>
        <div class="article-card-body">
          <span class="article-card-title">{{ article.data.title }}</span>
          <time datetime="{{ article.data.date }}">{{ article.data.date | formatDate }}</time>
        </div>
      </a>
    </article>
  {% endfor %}
</div>

{% if pagination.hrefs.length > 1 %}
<nav class="pagination" aria-label="Article pagination">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous }}" class="pagination-link pagination-prev" aria-label="Newer articles">&larr;</a>
  {% else %}
    <span class="pagination-link pagination-prev is-hidden" aria-hidden="true">&larr;</span>
  {% endif %}

  <ol class="pagination-pages">
    {% for href in pagination.hrefs %}
      <li>
        {% if loop.index0 == pagination.pageNumber %}
          <span class="pagination-page is-current" aria-current="page">{{ loop.index }}</span>
        {% else %}
          <a href="{{ href }}" class="pagination-page">{{ loop.index }}</a>
        {% endif %}
      </li>
    {% endfor %}
  </ol>

  {% if pagination.href.next %}
    <a href="{{ pagination.href.next }}" class="pagination-link pagination-next" aria-label="Older articles">&rarr;</a>
  {% else %}
    <span class="pagination-link pagination-next is-hidden" aria-hidden="true">&rarr;</span>
  {% endif %}
</nav>
{% endif %}
